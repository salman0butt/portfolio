NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Portfolio MCP server (/api/mcp). Server-side only — never expose these in NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=sb_secret_YOUR_DEDICATED_SERVER_SECRET_KEY
SUPABASE_BLOG_BUCKET=blog-images
PORTFOLIO_MCP_TOKEN=GENERATE_A_LONG_RANDOM_INTERNAL_BEARER_TOKEN

# ChatGPT custom MCP connection token. Use a separate disposable token because it is placed in the MCP URL.
PORTFOLIO_MCP_URL_TOKEN=GENERATE_A_DIFFERENT_LONG_RANDOM_TOKEN

# Only needed when the site is hosted under a sub-path (for example GitHub Pages /portfolio).
NEXT_PUBLIC_BASE_PATH=
