NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Portfolio MCP core (/api/mcp). Server-side only — never expose these in NEXT_PUBLIC_* variables.
SUPABASE_SECRET_KEY=sb_secret_YOUR_DEDICATED_SERVER_SECRET_KEY
SUPABASE_BLOG_BUCKET=blog-images
PORTFOLIO_MCP_TOKEN=GENERATE_A_LONG_RANDOM_BEARER_TOKEN

# OAuth-facing Portfolio MCP (/api/mcp-oauth).
# Must match the Supabase Auth user allowed to approve ChatGPT access.
PORTFOLIO_MCP_ADMIN_EMAIL=you@example.com

# Only needed when the site is hosted under a sub-path (for example GitHub Pages /portfolio).
NEXT_PUBLIC_BASE_PATH=
